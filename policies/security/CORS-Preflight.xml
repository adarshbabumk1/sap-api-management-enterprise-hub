<!--
    SAP API Management Policy: CORS Management (AssignMessage)
    Type: Security & Browser Compatibility
    Injects Cross-Origin Resource Sharing headers for web applications.
-->
<AssignMessage async="false" continueOnError="false" enabled="true" xmlns="http://www.sap.com/apimgmt">
    <Set>
        <Headers>
            <Header name="Access-Control-Allow-Origin">*</Header>
            <Header name="Access-Control-Allow-Headers">origin, content-type, accept, authorization, apikey, x-requested-with</Header>
            <Header name="Access-Control-Max-Age">3600</Header>
            <Header name="Access-Control-Allow-Methods">GET, PUT, POST, DELETE, PATCH, OPTIONS</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
